{
  "id": "/providers/Microsoft.Management/managementGroups/e2995d11-9947-4e78-9de6-d44e0603518e/providers/Microsoft.Authorization/policyDefinitions/CppStorageProdSoftDelete",
  "name": "CppStorageProdSoftDelete",
  "properties": {
    "description": "Denies configuration of a production storage account's blob, container or file share soft delete unless it is enabled with a retention period of at least the configured minimum number of days. A storage account is considered production unless its name, resource group, or 'environment' tag contains one of the configured non-production identifiers (e.g. prp, prx).",
    "displayName": "Production storage accounts must have blob, container and file soft delete enabled with a minimum retention period",
    "mode": "Indexed",
    "parameters": {
      "minimumRetentionDays": {
        "defaultValue": 14,
        "metadata": {
          "description": "The minimum number of days required for blob, container and file share soft delete retention",
          "displayName": "Minimum retention days"
        },
        "type": "Integer"
      },
      "nonProductionIdentifiers": {
        "defaultValue": [
          "prp",
          "prx"
        ],
        "metadata": {
          "description": "Substrings that, when found in the storage account name, resource group name, or 'environment' tag, identify the storage account as non-production",
          "displayName": "Non-production identifiers"
        },
        "type": "Array"
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "anyOf": [
              {
                "equals": "Microsoft.Storage/storageAccounts/blobServices",
                "field": "type"
              },
              {
                "equals": "Microsoft.Storage/storageAccounts/fileServices",
                "field": "type"
              }
            ]
          },
          {
            "count": {
              "name": "identifier",
              "value": "[parameters('nonProductionIdentifiers')]",
              "where": {
                "field": "name",
                "like": "[concat('*', current('identifier'), '*')]"
              }
            },
            "equals": 0
          },
          {
            "count": {
              "name": "identifier",
              "value": "[parameters('nonProductionIdentifiers')]",
              "where": {
                "field": "id",
                "like": "[concat('*/resourceGroups/*', current('identifier'), '*/providers/*')]"
              }
            },
            "equals": 0
          },
          {
            "count": {
              "name": "identifier",
              "value": "[parameters('nonProductionIdentifiers')]",
              "where": {
                "field": "tags['environment']",
                "like": "[concat('*', current('identifier'), '*')]"
              }
            },
            "equals": 0
          },
          {
            "anyOf": [
              {
                "allOf": [
                  {
                    "equals": "Microsoft.Storage/storageAccounts/blobServices",
                    "field": "type"
                  },
                  {
                    "anyOf": [
                      {
                        "field": "Microsoft.Storage/storageAccounts/blobServices/containerDeleteRetentionPolicy.enabled",
                        "notEquals": true
                      },
                      {
                        "field": "Microsoft.Storage/storageAccounts/blobServices/containerDeleteRetentionPolicy.days",
                        "less": "[parameters('minimumRetentionDays')]"
                      },
                      {
                        "field": "Microsoft.Storage/storageAccounts/blobServices/deleteRetentionPolicy.enabled",
                        "notEquals": true
                      },
                      {
                        "field": "Microsoft.Storage/storageAccounts/blobServices/deleteRetentionPolicy.days",
                        "less": "[parameters('minimumRetentionDays')]"
                      }
                    ]
                  }
                ]
              },
              {
                "allOf": [
                  {
                    "equals": "Microsoft.Storage/storageAccounts/fileServices",
                    "field": "type"
                  },
                  {
                    "anyOf": [
                      {
                        "field": "Microsoft.Storage/storageAccounts/fileServices/shareDeleteRetentionPolicy.enabled",
                        "notEquals": true
                      },
                      {
                        "field": "Microsoft.Storage/storageAccounts/fileServices/shareDeleteRetentionPolicy.days",
                        "less": "[parameters('minimumRetentionDays')]"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "then": {
        "effect": "Deny"
      }
    },
    "policyType": "Custom"
  },
  "type": "Microsoft.Authorization/policyDefinitions"
}
